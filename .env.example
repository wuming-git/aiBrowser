# 本地开发（npm run dev 默认读这个或 .env）
VITE_API_BASE=http://127.0.0.1:8080

# 线上打包请使用 .env.production：
# VITE_API_BASE=https://browser168.com
#
# 注意：不要写成 https://browser168.com/api
# 因为代码请求路径已是 /api/auth、/api/profiles、/ws/desktop

# 可选：文档说明用。客户端全量更新源由 Electron 主进程读取：
# UPDATE_FEED_URL（默认 https://browser168.com/releases）
# VITE_UPDATE_FEED_URL=https://browser168.com/releases
